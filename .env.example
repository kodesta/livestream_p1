# Server Port (assigned automatically by cloud hosts like Render/Railway/Heroku)
PORT=3000

# PostgreSQL Database Connection URL
# Replace with your cloud database connection string (e.g., from Supabase, Neon, Railway, or Render)
DATABASE_URL="postgresql://postgres:password@localhost:5432/livestream_db?schema=public"

# Optional: Language for KinoCheck trending trailers (default: en)
KINOCHECK_LANG=en
